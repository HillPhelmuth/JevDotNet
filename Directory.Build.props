<Project>

  <!-- Versions. DecisionsDotNet and its add-on packages (.AI, .Testing, .Caching) always ship together; ExtractionsDotNet versions on its own. -->
  <PropertyGroup>
    <DecisionsVersion>1.1.0</DecisionsVersion>
    <ExtractionsVersion>1.0.0</ExtractionsVersion>
  </PropertyGroup>

  <!-- The shipped packages. Everything conditioned on IsShippedPackage skips the demo and tests. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DecisionsDotNet' or '$(MSBuildProjectName)' == 'DecisionsDotNet.AI' or '$(MSBuildProjectName)' == 'DecisionsDotNet.Testing' or '$(MSBuildProjectName)' == 'DecisionsDotNet.Caching' or '$(MSBuildProjectName)' == 'ExtractionsDotNet'">
    <IsShippedPackage>true</IsShippedPackage>
    <!-- Every public member needs an XML doc comment; a missing one (CS1591) fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- RS00xx: the public surface must match PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt, so API changes are a visible diff. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;RS0016;RS0017;RS0036;RS0037</WarningsAsErrors>
    <!-- RS0026/RS0027 object to overloads that both take optional parameters; the Add* and builder overloads are deliberate. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Compares each package against its last stable release, so a breaking change fails the pack. Caching and Testing first shipped in 1.1. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DecisionsDotNet' or '$(MSBuildProjectName)' == 'DecisionsDotNet.AI' or '$(MSBuildProjectName)' == 'ExtractionsDotNet'">
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- Settings shared by the shipped packages. Harmless for the demo and tests, which are never packed. -->
  <PropertyGroup>
    <Authors>Adam Holm</Authors>
    <Copyright>Copyright (c) Adam Holm</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/HillPhelmuth/JevDotNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HillPhelmuth/JevDotNet</RepositoryUrl>
    <PackageReleaseNotes>https://github.com/HillPhelmuth/JevDotNet/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
