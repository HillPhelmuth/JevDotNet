<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>JevDotNet</PackageId>
    <PackageVersion>0.0.1-preview</PackageVersion>
    <Title>JevDotNet - TypeSafe AI and OpenRouter Decisions SDK</Title>
    <Authors>Adam Holm</Authors>
    <Description>Type-safe .NET client for TypeSafe AI Jev models and the OpenRouter Decisions API, with typed decision questions and responses, dependency injection, cancellation, and bounded HTTP retries.</Description>
    <PackageTags>Jev;TypeSafe;OpenRouter;AI;decisions;SDK;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>C:\Users\adamh\source\LocalPackages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <None Include="..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
