<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <RootNamespace>DecisionsDotNet</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DecisionsDotNet</PackageId>
    <PackageVersion>0.2.0-preview</PackageVersion>
    <Title>DecisionsDotNet - TypeSafe AI SystemOne, OpenRouter, and OpenAI Decisions SDK</Title>
    <Authors>Adam Holm</Authors>
    <Description>Type-safe .NET client for TypeSafe AI Jev models and the OpenRouter and OpenAI Decisions APIs, with typed decision questions and responses, dependency injection, cancellation, and bounded HTTP retries.</Description>
    <PackageTags>Jev;TypeSafe;OpenRouter;OpenAI;AI;decisions;SDK;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath Condition="'$(Configuration)' == 'Debug'">C:\Users\adamh\source\LocalPackages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">True</GeneratePackageOnBuild>
    <PackageProjectUrl>https://github.com/HillPhelmuth/JevDotNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HillPhelmuth/JevDotNet</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <None Include="..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
